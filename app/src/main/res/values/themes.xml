<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Lepao" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryDark">@color/brand_dark</item>
        <item name="colorAccent">@color/brand</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/brand_dark</item>
    </style>

    <style name="Widget.Lepao.Card" parent="">
        <item name="android:background">@drawable/card_bg</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="Widget.Lepao.CardTitle" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Lepao.Body" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="Widget.Lepao.Label" parent="">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Widget.Lepao.Button" parent="Widget.AppCompat.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="backgroundTint">@color/button_primary_tint</item>
    </style>

    <style name="Widget.Lepao.Button.Secondary" parent="Widget.Lepao.Button">
        <item name="android:textColor">@color/button_secondary_text_tint</item>
        <item name="backgroundTint">@color/button_secondary_tint</item>
    </style>
</resources>
